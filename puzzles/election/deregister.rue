// election/deregister.rue
// Deregister action for the Election Singleton.
//
// Weighted-voting revision: per-voter lockup is bound into the SMT
// leaf preimage at register time (`sha256(pubkey ||
// locked_cat_mojos_be8)`), so deregister recovers the voter's actual
// locked amount via the membership proof — the puzzle only accepts
// the leaf preimage that re-hashes to the active leaf the proof
// authenticates. That recovered amount is what gets refunded back
// out of `registration_vote_weight`, keeping the running total
// honest with each voter's contribution.
//
// A registered voter exits the registered set. The action:
//   1. Verifies the voter's slot index is the canonical slot derived
//      from their pubkey (sha256(pubkey) prefix), matching the slot
//      register.rue would have placed them in.
//   2. Verifies a membership proof for that slot — active leaf is
//      `sha256(pubkey || locked_cat_mojos_be8)` — against the current
//      SPT root. Honest `locked_cat_mojos` is enforced by the merkle
//      proof: any other value produces a different leaf and the
//      proof fails.
//   3. Computes the new SPT root with EMPTY_LEAF_HASH at the same
//      slot — i.e. the voter's leaf is wiped.
//   4. Decrements registration_count by 1 and
//      registration_vote_weight by the recovered `locked_cat_mojos`.
//   5. Emits a coin announcement authorizing the matching Registration
//      Coin's `release` action to unlock collateral. The release path
//      asserts this exact announcement.
//   6. Requires AggSigMe from the voter pubkey so only the voter can
//      deregister themselves.
//
// Note: deregistration is independent of any ballot's finalize state.
// A voter may deregister mid-deployment; their Voting Coins remain on
// chain and continue to be aggregable for ballots they cast on prior
// to deregistration. Per CHIP rev 2026-05-02 the singleton's
// `deregister` announcement is the canonical authorization for
// collateral release; ballot finalize announcements are not.

import super::common_types::*;
import super::poseidon::*;
import shared::*;

// SEC-F1: Poseidon-over-Jubjub registration SPT (matches register.rue +
// merkle.rs::PoseidonSmt). Slot from the voter's Jubjub pubkey coords.
inline fn slot_from_jubjub(jub_x: Bytes32, jub_y: Bytes32) -> Int {
    let h: Bytes = sha256((jub_x as Bytes) + (jub_y as Bytes)) as Bytes;
    let prefix: Bytes = substr(h, 0, 4);
    let unsigned_bytes: Bytes = 0x00 as Bytes + prefix;
    unsigned_bytes as Int
}

fn compute_root(
    node: Int,
    index: Int,
    remaining: HashCons,
    depth_remaining: Int,
) -> Int {
    if depth_remaining == 0 {
        node
    } else {
        let sibling: Int = remaining.head as Int;
        let parent: Int = if index % 2 == 0 {
            hash2(node, sibling)
        } else {
            hash2(sibling, node)
        };
        compute_root(parent, index / 2, remaining.tail, depth_remaining - 1)
    }
}

fn main(
    // ── Curried ─────────────────────────────────────────────────────
    TREE_DEPTH: Int,
    EMPTY_LEAF_HASH: Bytes32,
    COLLATERAL_AMOUNT: Int,
    REGISTRATION_MERKLE_ROOT: Bytes32,
    Truth: ElectionStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    voter_pubkey: PublicKey,
    // SEC-F1: the voter's Jubjub pubkey coords — the SMT leaf commits these.
    jub_x: Bytes32,
    jub_y: Bytes32,
    deregister_leaf_index: Int,
    locked_cat_mojos: Int,
    ...deregister_siblings: HashCons,
) -> (ElectionStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // Slot integrity: index MUST be the canonical slot for this Jubjub key
    // (matches register.rue's invariant).
    let computed_slot: Int = slot_from_jubjub(jub_x, jub_y);
    assert deregister_leaf_index == computed_slot;

    // SECURITY (SEC-DEREGISTER-UNDERFLOW + floor parity with register):
    // register.rue enforces `locked_cat_mojos >= COLLATERAL_AMOUNT`;
    // deregister previously enforced no floor and no underflow guard, so
    // an out-of-range / aliased `locked_cat_mojos` could over-decrement
    // the running tally. The central `int_to_8_bytes_be` range guard now
    // rejects `locked_cat_mojos` outside [0, 2^64) when `active_leaf` is
    // computed below (closing the `X + 2^64` aliasing variant); these
    // asserts add the collateral floor and a hard non-negative invariant
    // on the post-decrement weight and count so a malformed deregister
    // can never drive `registration_vote_weight` / `registration_count`
    // negative.
    let max_u64: Int = 0x010000000000000000 as Int;
    assert locked_cat_mojos >= COLLATERAL_AMOUNT;
    assert locked_cat_mojos < max_u64;
    assert State.registration_vote_weight - locked_cat_mojos >= 0;
    assert State.registration_count - 1 >= 0;

    // Membership proof: the slot currently holds the weighted SMT
    // leaf — sha256(pubkey || locked_cat_mojos_be8) — matching the
    // formula register.rue committed to at registration time. The
    // proof verifies ONLY for the exact `locked_cat_mojos` the
    // voter registered with; any other value produces a different
    // leaf hash and the proof fails. This is what keeps the
    // recovered amount honest — no separate signature required.
    let pk_b: Bytes = voter_pubkey as Bytes;
    // SEC-F1: Poseidon leaf over the Jubjub pubkey + weight (matches
    // register.rue + PoseidonSmt). The proof still verifies only for the
    // exact `locked_cat_mojos` the voter registered with.
    let active_leaf: Int = hash_leaf(jub_x as Int, jub_y as Int, locked_cat_mojos);
    let pre_root: Int = compute_root(
        active_leaf, deregister_leaf_index, deregister_siblings, TREE_DEPTH,
    );
    assert pre_root == (State.registration_merkle_root as Int);

    // New root with the voter's leaf wiped to EMPTY_LEAF_HASH (Poseidon
    // empty leaf). `int_to_32_bytes_be` always yields 32 bytes.
    let new_root_int: Int = compute_root(
        EMPTY_LEAF_HASH as Int, deregister_leaf_index, deregister_siblings, TREE_DEPTH,
    );
    let new_root_b: Bytes = int_to_32_bytes_be(new_root_int);
    assert new_root_b is Bytes32;
    let new_root: Bytes32 = new_root_b;

    // Voter's signature authorizing their own deregistration. Bound to
    // the election launcher so a sig from one election cannot replay on
    // another.
    let bbl_b: Bytes = State.registration_merkle_root as Bytes;
    let deregister_sig_message: Bytes32 = sha256(
        "deregister_self"
        + pk_b
        + bbl_b
    );
    let agg_sig_deregister = AggSigMe {
        public_key: voter_pubkey,
        message: deregister_sig_message,
    };

    // SEC-F4: authorize the Registration Coin's `release` action via
    // CHIP-0025 SEND_MESSAGE (mode = SENDER_PUZZLE) rather than a
    // forgeable coin announcement. The paired RECEIVE_MESSAGE in
    // release.rue commits THIS singleton's puzzle hash as the message
    // sender (re-derived from election_launcher_id), so only the genuine
    // Election Singleton can authorize a collateral release. No
    // receiver-side commitment (lower mode bits = 0): the message is
    // uniquely keyed by `sha256("deregister" || voter_pubkey)`.
    let send_deregister = SendMessage {
        mode: SENDER_PUZZLE,
        message: deregister_announcement_msg(voter_pubkey) as Bytes,
        receiver: [],
    };

    let new_state = ElectionState {
        registration_merkle_root: new_root,
        registration_count: State.registration_count - 1,
        registration_vote_weight: State.registration_vote_weight - locked_cat_mojos,
        election_start_height: State.election_start_height,
        ceremony_launcher_id: State.ceremony_launcher_id,
        max_voters: State.max_voters,
        vk_hash: State.vk_hash,
        vote_mode_lock: State.vote_mode_lock,
    };

    (
        ElectionStateTruth {
            Ephemeral_State: Truth.Ephemeral_State,
            State: new_state,
        },
        [
            agg_sig_deregister,
            send_deregister,
        ],
    )
}
