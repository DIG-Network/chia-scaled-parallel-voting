// election/finalize.rue
// Finalize action for the Election Singleton.
//
// One-shot action: verifies a Groth16 proof + BLS aggregate signature
// proving that a majority of registered voters signed the vote outcome,
// then transitions state to finalized=true with the committed outcome.
// Pays the accumulated registration fees to the finalizer's destination
// and emits the finalization announcement.
//
// Time lock: emits ASSERT_HEIGHT_RELATIVE(ELECTION_LENGTH_BLOCKS) to
// require ELECTION_LENGTH_BLOCKS L1 blocks of quiet since the singleton
// coin currently being spent was created. Because every register spend
// recreates the singleton, this enforces a settling window since the
// last registration. Without it, the very first registrant could
// trivially satisfy `2*1 > 1` and finalize unilaterally.
//
// State transitions:
//   accumulated_fees → 0   (paid out to finalizer in this same spend)
//   finalized        → true
//   vote_outcome     → vote_outcome_data
//
// The election finalizer reads the new accumulated_fees=0 and recreates
// the singleton with amount=1 (the original 1 + 0 fees).

import shared::*;

struct VK {
    alpha: PublicKey,
    beta: Signature,
    gamma: Signature,
    delta: Signature,
}

struct IC {
    ic0: PublicKey,
    ic1: PublicKey,    // multiplied by scalar(registration_merkle_root)
    ic2: PublicKey,    // multiplied by scalar(registration_count)
    ic3: PublicKey,    // multiplied by scalar(agg_signers)
    ic4: PublicKey,    // multiplied by scalar(vote_message)
}

struct Proof {
    a: PublicKey,
    b: Signature,
    c: PublicKey,
}

struct Scalars {
    s1: PublicKey,    // sha256(registration_merkle_root)
    s2: PublicKey,    // sha256(registration_count_be8)
    s3: PublicKey,    // sha256(agg_signers)
    s4: PublicKey,    // sha256(vote_message)
}

fn main(
    // ── Curried (action-specific config) ────────────────────────────
    VK: VK,
    IC: IC,
    ELECTION_LENGTH_BLOCKS: Int,
    ELECTION_LAUNCHER_ID: Bytes32,
    Truth: ElectionStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    proof: Proof,
    vote_outcome_data: Bytes32,
    agg_signers: PublicKey,
    agg_sig: Signature,
    scalars: Scalars,
    ...finalizer_destination: Bytes32,
) -> (ElectionStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // One-shot.
    assert State.finalized == false;

    // Time lock — see header comment.
    let assert_min_elapsed = AssertHeightRelative {
        height: ELECTION_LENGTH_BLOCKS,
    };

    // Vote message binds the outcome to the network identity (election launcher id).
    let outcome_b: Bytes = vote_outcome_data as Bytes;
    let net_id_b: Bytes = ELECTION_LAUNCHER_ID as Bytes;
    let vote_message: Bytes32 = sha256(outcome_b + net_id_b);

    // Scalar verification — bind each scalar to `sha256(input) mod r`,
    // where r is the BLS12-381 subgroup order.
    //
    // WHY mod r: CLVM's `bls_g1_multiply` opcode interprets its
    // scalar argument as a SIGNED big-endian integer (two's-
    // complement). A raw sha256 output whose first byte ≥ 0x80
    // would be treated as a NEGATIVE number, and CLVM's
    // `mod_group_order` returns `r - (|n| mod r)` for negatives —
    // a different scalar than the off-chain prover's
    // `Fr::from_be_bytes_mod_order(unsigned_sha256_bytes)`
    // commitment. Reducing each scalar mod r BEFORE storing it
    // in the solution forces the value < r < 2^254, so the high
    // bit is always 0 and signed/unsigned interpretations agree.
    //
    // WHY `%` (op 61 = `op_mod`) AND NOT `modpow` (op 60):
    // mainnet's MEMPOOL_MODE flag enables `DISABLE_OP`, which
    // **disables `op_modpow` entirely** ("unimplemented operator
    // 60") — even though it's a hardforked op outside any
    // softfork guard. `op_mod` has no such guard (in mempool
    // mode it just swaps to `op_mod_limit`, the strict variant
    // that bounds the modulus length to 256 bits — well above
    // our 32-byte `r`). Since `b^1 = b`, `b mod r == modpow(b,
    // 1, r)` for our scalar reduction, so swapping is a
    // semantics-preserving fix. (NB: clvmr 0.14 — what our SDK
    // pulls — silently DOES allow modpow in mempool mode, which
    // is why our local `validate_clvm_and_signature` pre-flight
    // historically passed with a `modpow`-using puzzle while
    // mainnet rejected with `GENERATOR_RUNTIME_ERROR`.)
    //
    // `as Int` interprets bytes as a SIGNED big-endian two's-
    // complement integer. To force the UNSIGNED interpretation
    // (matching arkworks' `Fr::from_be_bytes_mod_order`), we
    // prepend `0x00` before the cast so the high bit is always 0.
    let r: Bytes = 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001;
    let zero_pad: Bytes = 0x00;
    let vmr_b: Bytes = State.registration_merkle_root as Bytes;
    assert ((zero_pad + sha256(vmr_b)) as Int % (r as Int)) as Bytes
        == (scalars.s1 as Bytes);
    assert (
        (zero_pad + sha256(int_to_8_bytes_be(State.registration_count))) as Int
        % (r as Int)
    ) as Bytes == (scalars.s2 as Bytes);
    let agg_b: Bytes = agg_signers as Bytes;
    assert ((zero_pad + sha256(agg_b)) as Int % (r as Int)) as Bytes
        == (scalars.s3 as Bytes);
    let vm_b: Bytes = vote_message as Bytes;
    assert ((zero_pad + sha256(vm_b)) as Int % (r as Int)) as Bytes
        == (scalars.s4 as Bytes);

    // VK input: IC[0] + IC[1]*s1 + ... + IC[4]*s4.
    let vk_input: PublicKey = IC.ic0
        + IC.ic1 * scalars.s1
        + IC.ic2 * scalars.s2
        + IC.ic3 * scalars.s3
        + IC.ic4 * scalars.s4;

    // Groth16 pairing identity.
    bls_pairing_identity(
        proof.a,    proof.b,
        -VK.alpha,  VK.beta,
        -vk_input,  VK.gamma,
        -proof.c,   VK.delta,
    );

    // ── BLS aggregate signature verification (PoP / unaugmented) ─
    //
    // We verify the aggregate signature via the textbook BLS
    // pairing identity:
    //
    //   e(agg_signers, H(vote_message)) * e(-G1_GENERATOR, agg_sig) = 1
    //
    // which is equivalent to the single-pair check
    //
    //   e(G1_GENERATOR, agg_sig) == e(agg_signers, H(vote_message))
    //
    // — i.e. agg_sig decomposes against agg_signers over
    // H(vote_message) under UNAUGMENTED BLS aggregation.
    //
    // WHY NOT `bls_verify(agg_sig, agg_signers, vote_message)`:
    // CLVM's `bls_verify` opcode is implemented as
    // `aggregate_verify` which AUGMENTS each (pk, msg) pair
    // internally with `pk || msg` before hashing-to-G2. With a
    // single pair `(agg_signers, vote_message)` it would require
    // each voter's contribution to be `sk_i · H(agg_signers ‖ msg)`
    // — i.e. each voter would need to sign with knowledge of the
    // eventual aggregate pubkey (a two-round signing protocol).
    // Voters in this CHIP sign independently at vote time without
    // coordinator interaction, producing
    //   sig_i = sk_i · H(vote_message)
    // (chia_bls::sign_raw under the AUG_ DST, no augmentation
    // applied). The sum sk_agg · H(vote_message) is then the
    // expected `agg_sig`, and the pairing identity above is the
    // mathematically correct single-pair check for that scheme.
    //
    // CHIP-0050 / CHIP-Groth16-L2-Consensus security: the circuit
    // pins `agg_signers == G1_sum(signing_pubkeys)` (constraint D
    // in spec-groth16-circuit), so a phantom-majority attacker
    // cannot lie about `agg_signers` without also producing a
    // matching invalid Groth16 proof.
    //
    // DST choice: `g2_map(vote_message)` defaults to
    // `BLS_SIG_BLS12381G2_XMD:SHA-256_SSWU_RO_AUG_` — the SAME
    // DST `chia_bls::hash_to_g2` (and therefore `sign_raw`) uses
    // — so on-chain and off-chain hash-to-G2 outputs match.
    //
    // G1_GENERATOR is the standard BLS12-381 G1 generator in
    // ZCash compressed form (48 bytes). Sourced from
    // `chia_bls::PublicKey::generator()`'s ground-truth bytes.
    let G1_GENERATOR: PublicKey =
        0x97f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb;
    let h_vote_message: Signature = g2_map(vote_message as Bytes);
    bls_pairing_identity(
        agg_signers,     h_vote_message,
        -G1_GENERATOR,   agg_sig,
    );

    // Pay the accumulated fees to the finalizer.
    let pay_finalizer = CreateCoin {
        puzzle_hash: finalizer_destination,
        amount: State.accumulated_fees,
        memos: nil,
    };

    // Finalization announcement — asserted by Registration Coins
    // (release action) when releasing collateral.
    let announce_finalize = CreateCoinAnnouncement {
        message: finalization_announcement_msg(
            vote_outcome_data,
            State.registration_count,
            State.registration_merkle_root,
        ),
    };

    let new_state = ElectionState {
        registration_merkle_root: State.registration_merkle_root,
        registration_count: State.registration_count,
        accumulated_fees: 0,                     // zeroed → singleton amount drops back to 1
        finalized: true,
        vote_outcome: vote_outcome_data,
    };

    (
        ElectionStateTruth {
            Ephemeral_State: Truth.Ephemeral_State,
            State: new_state,
        },
        [
            assert_min_elapsed,
            pay_finalizer,
            announce_finalize,
        ],
    )
}
