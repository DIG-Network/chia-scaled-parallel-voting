// election/create_ballot.rue
// CreateBallot action for the Election Singleton.
//
// Mints a fresh Ballot Coin lineage. Following the standard Chia
// singleton-launch pattern, the action emits a launcher EVE coin
// (a 2-mojo coin at SINGLETON_LAUNCHER_PUZZLE_HASH) as a child of the
// current Election Singleton spend. Whoever knows the resulting
// eve coin id can then spend the launcher to instantiate the Ballot
// Coin singleton; the driver / SDK is responsible for that follow-up
// spend with the correct deployment-wide curries (VK, IC, threshold
// pack, BALLOT_ACTIONS_MERKLE_ROOT) and per-ballot args
// (vote_close_height, outcome_domain_hash). All Ballot Coins minted
// from a given Election Singleton inherit a stable
// `ballot_launcher_id = eve_coin_id` that uniquely identifies the
// ballot for the rest of the system.
//
// EVEN-AMOUNT LAUNCHER: the launcher coin is minted at amount 2 (not
// the conventional 1) so the standard singleton top-layer's
// `check_and_morph_conditions_for_singleton` does NOT mistake it for
// the singleton's own recreation. That helper raises if it observes
// more than one odd-amount CreateCoin in the inner conditions; the
// finalizer already emits one (the singleton recreation at amount 1),
// so the launcher mint MUST be even. The downstream launcher-spend
// pass through `SINGLETON_LAUNCHER_PUZZLE_HASH` then mints the eve
// Ballot Coin singleton at the (odd) amount the operator chooses.
//
// The action:
//   1. Pins the singleton's current coin id via AssertMyCoinId so the
//      eve coin id can be derived deterministically inside the puzzle.
//   2. Computes eve_coin_id = sha256(singleton_coin_id ||
//      SINGLETON_LAUNCHER_PUZZLE_HASH || 8-byte BE 2).
//   3. Emits CreateCoin for the launcher eve coin with hint =
//      eve_coin_id (= ballot_launcher_id) so indexers can find it.
//   4. Emits an indexer-facing CreateCoinAnnouncement carrying
//      ballot_launcher_id, vote_close_height, and outcome_domain_hash.
//   5. Recreates the Election Singleton with state UNCHANGED — ballot
//      issuance does not mutate registration_count, vote_weight, or
//      the SPT root. The election finalizer applies the no-op state.
//
// Permissions: this action is unsigned-by-puzzle-design. Deployment
// guardrails for who may mint ballots SHOULD live in a wrapper key
// or governance layer outside this CHIP's scope (the singleton
// merely enforces that ballot lineage is traceable here).

import super::common_types::*;
import shared::*;

fn main(
    // ── Curried ─────────────────────────────────────────────────────
    SINGLETON_LAUNCHER_PUZZLE_HASH: Bytes32,
    ELECTION_LAUNCHER_ID: Bytes32,
    // M6: sentinel "no lock" for VOTE_MODE_LOCK. When State.vote_mode_lock
    // equals this, ballot creators can pick any vote_options_root.
    NO_VOTE_MODE_LOCK: Bytes32,
    Truth: ElectionStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    singleton_coin_id: Bytes32,
    ballot_seed: Bytes32,
    vote_close_height: Int,
    outcome_domain_hash: Bytes32,
    // M6: per-ballot vote-mode root the new Ballot Coin will be curried
    // with. 0x00…00 = Mode1Free; any other value = sorted-options merkle
    // root (Mode2Restricted). Threaded through the new ballot's curry
    // composition (off-chain in the SDK) so the ballot's oracle can
    // commit to it. Gated below against State.vote_mode_lock when the
    // election was deployed mode-locked.
    ...ballot_vote_options_root: Bytes32,
) -> (ElectionStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // M6: if the election is mode-locked, the ballot creator MUST use
    // the locked options root byte-for-byte. Implemented as an
    // AssertSeconds-style hard equality: emit nothing on success;
    // raise on mismatch by feeding a tautological hash assertion.
    // The simpler form: encode the gate as a trinary value the
    // condition layer can drop.
    let mode_lock_ok: Bool = if State.vote_mode_lock == NO_VOTE_MODE_LOCK {
        true
    } else {
        State.vote_mode_lock == ballot_vote_options_root
    };
    assert mode_lock_ok;

    // Pin the singleton's current coin id. CLVM ASSERT_MY_COIN_ID will
    // reject the spend if `singleton_coin_id` doesn't match the actual
    // coin being spent — this is what lets the puzzle compute the eve
    // coin id deterministically.
    let assert_self = AssertMyCoinId {
        coin_id: singleton_coin_id,
    };

    // Eve coin id = sha256(parent_coin_id || puzzle_hash || amount_be8).
    // This becomes the Ballot Coin's launcher_id once the eve coin is
    // spent through the standard SINGLETON_LAUNCHER puzzle in a
    // follow-up spend the driver builds. Amount = 2 (even) so the
    // singleton outer's single-odd-CreateCoin invariant is preserved.
    let eve_coin_id: Bytes32 = sha256(
        (singleton_coin_id as Bytes)
        + (SINGLETON_LAUNCHER_PUZZLE_HASH as Bytes)
        + int_to_8_bytes_be(2)
    );

    // Mint the launcher eve coin (amount 2 — see EVEN-AMOUNT LAUNCHER
    // note in the file header). Hint = ballot_launcher_id so off-chain
    // indexers can find both the eve coin and (after the launcher
    // spend) the Ballot Coin lineage by the same key.
    let mint_eve = CreateCoin {
        puzzle_hash: SINGLETON_LAUNCHER_PUZZLE_HASH,
        amount: 2,
        memos: Memos {
            value: [eve_coin_id],
        },
    };

    // Indexer / aggregator announcement — carries every ballot config
    // value the SDK needs to reconstruct the Ballot Coin's curried
    // puzzle hash off-chain. ballot_seed is included so successive
    // create_ballot spends in the same block (which would otherwise
    // produce identical announcement preimages because the singleton
    // coin id is fresh per-spend) are still distinguishable to relays.
    // M6: ballot_vote_options_root is appended so observers can recover
    // the ballot's vote-mode commitment from chain alone.
    let announce_create = CreateCoinAnnouncement {
        message: sha256(
            "ballot_created"
            + (ELECTION_LAUNCHER_ID as Bytes)
            + (eve_coin_id as Bytes)
            + (ballot_seed as Bytes)
            + int_to_8_bytes_be(vote_close_height)
            + (outcome_domain_hash as Bytes)
            + (ballot_vote_options_root as Bytes)
        ),
    };

    // State unchanged.
    (
        Truth,
        [
            assert_self,
            mint_eve,
            announce_create,
        ],
    )
}
