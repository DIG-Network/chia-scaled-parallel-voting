// election/register.rue
// Register action for the Election Singleton.
//
// Weighted-voting revision: each voter chooses how much CAT to lock
// (`locked_cat_mojos`), bounded below by `COLLATERAL_AMOUNT`. The
// locked amount is bound into the SMT leaf preimage so the on-chain
// register / deregister actions and the off-chain Groth16 finalize
// circuit all agree on every voter's contribution to `signed_weight`.
//
// A voter joins the registered set. The action:
//   1. Verifies the voter's slot index is the canonical slot derived
//      from their pubkey (sha256(pubkey) prefix).
//   2. Verifies an emptiness proof for that slot against the current
//      SPT root.
//   3. Verifies `locked_cat_mojos >= COLLATERAL_AMOUNT` (the curried
//      minimum) — voters may lock more than the floor for higher
//      weight.
//   4. Computes the new SPT root with
//      `sha256(pubkey || locked_cat_mojos_be8)` inserted at the slot.
//   5. Computes the expected CAT-wrapped Registration Coin puzzle hash
//      and asserts a CreateCoinAnnouncement from the parent CAT spend
//      confirming the Registration Coin was created with that puzzle
//      hash and `locked_cat_mojos`. This binds the on-chain CAT lockup
//      to the registration so the voter cannot under- or over-state
//      their lock relative to the SMT leaf.
//   6. Updates state: increments registration_count, adds
//      `locked_cat_mojos` to registration_vote_weight, stores the new
//      SPT root.
//   7. Requires AggSigMe from the registering voter pubkey.
//
// The Registration Coin puzzle hash that must be created is:
//
//   CAT(CAT_TAIL_HASH,
//       action_layer(
//           registration_finalizer_full_hash(HINT),
//           REGISTRATION_MERKLE_ROOT,                     // constant for this election
//           initial_RegistrationState(voter_pubkey, election_id, EMPTY_BALLOT_ROOT),
//       )
//   )
//
// where HINT = sha256("CHIP/onchain/voter_hint/v1/" ||
//                     election_launcher_id ||
//                     cat_tail_hash ||
//                     voter_pubkey).
//
// The voter's spend bundle must include:
//   - A CAT spend that creates the Registration Coin at this exact
//     puzzle hash with COLLATERAL_AMOUNT, emitting the matching
//     "create_reg" CreateCoinAnnouncement.
//
// No XCH registration fee under CHIP rev 2026-05-02; the singleton's
// recreated coin amount does NOT grow on register.

import super::common_types::*;
import super::registration_coin::shared::*;
import super::poseidon::*;
import shared::*;

// SEC-F1: the registration SPT is now a Poseidon-over-Jubjub tree (so the
// finalize circuit can prove membership cheaply). The slot is derived from
// the voter's JUBJUB pubkey coordinates (32-byte BE), matching
// `merkle.rs::PoseidonSmt::slot_for_jubjub`.
inline fn slot_from_jubjub(jub_x: Bytes32, jub_y: Bytes32) -> Int {
    let h: Bytes = sha256((jub_x as Bytes) + (jub_y as Bytes)) as Bytes;
    let prefix: Bytes = substr(h, 0, 4);
    let unsigned_bytes: Bytes = 0x00 as Bytes + prefix;
    unsigned_bytes as Int
}

// SEC-F1: Poseidon Merkle root over Int field elements (node = hash2),
// matching merkle.rs::PoseidonSmt + the in-circuit membership. Siblings are
// passed as Bytes32 (32-byte BE of Fr) and interpreted as Int.
fn compute_root(
    node: Int,
    index: Int,
    remaining: HashCons,
    depth_remaining: Int,
) -> Int {
    if depth_remaining == 0 {
        node
    } else {
        let sibling: Int = remaining.head as Int;
        let parent: Int = if index % 2 == 0 {
            hash2(node, sibling)
        } else {
            hash2(sibling, node)
        };
        compute_root(parent, index / 2, remaining.tail, depth_remaining - 1)
    }
}

/// Compute the CAT-wrapped puzzle hash of a freshly registered
/// Registration Coin (empty per-registration ballot SPT, no release
/// destination) for this voter.
fn fresh_registration_coin_puzzle_hash(
    cat_mod_hash: Bytes32,
    cat_tail_hash: Bytes32,
    action_layer_mod_hash: Bytes32,
    registration_finalizer_mod_hash: Bytes32,
    registration_merkle_root: Bytes32,
    voter_pubkey: PublicKey,
    election_launcher_id: Bytes32,
    empty_ballot_root: Bytes32,
    // SEC-F2: bound into the registration coin's initial state so the
    // coin's puzzle hash commits to the weight, and every later spend can
    // `AssertMyAmount(locked_weight)`.
    locked_weight: Int,
) -> Bytes32 {
    // Per-voter hint baked into the finalizer's curry — gives off-chain
    // indexers a stable lookup key for this voter's registration coin
    // lineage across mint_voting_coin / release spends. Binds launcher,
    // CAT asset, and voter so hinted coins cannot collide across
    // elections or tails.
    let hint: Bytes32 = sha256(
        "CHIP/onchain/voter_hint/v1/"
        + (election_launcher_id as Bytes)
        + (cat_tail_hash as Bytes)
        + (voter_pubkey as Bytes)
    );

    // Initial state: empty per-registration ballot SPT, no release
    // destination yet (set later by the singleton's `deregister` action).
    let initial_state = RegistrationState {
        voter_pubkey: voter_pubkey,
        election_launcher_id: election_launcher_id,
        voted_ballots_root: empty_ballot_root,
        locked_weight: locked_weight,
        release_destination: nil,
    };

    // Finalizer: 1st curry binds (ACTION_LAYER_MOD_HASH, HINT); 2nd
    // curry binds the finalizer's own first-curry hash (the standard
    // "self-hash" pattern from CHIP-0050).
    let finalizer_first_curry_hash: Bytes32 = curry_tree_hash(
        registration_finalizer_mod_hash,
        [
            tree_hash_atom(action_layer_mod_hash),
            tree_hash_atom(hint),
        ],
    );
    let finalizer_full_hash: Bytes32 = curry_tree_hash(
        finalizer_first_curry_hash,
        [
            tree_hash_atom(finalizer_first_curry_hash),
        ],
    );

    // Action layer: curry(action_layer, [finalizer_full_hash, MERKLE_ROOT, STATE])
    //
    // Curry-arg convention (matches yakuhito's slot-machine):
    //   * Atom values are wrapped with `tree_hash_atom(...)`.
    //   * Already-tree-hashed values (the result of another
    //     `curry_tree_hash`) are passed DIRECTLY — they already
    //     represent `tree_hash(program)`, so pre-wrapping with
    //     `tree_hash_atom` would double-hash and mis-predict the
    //     puzzle hash.
    let action_layer_inner_hash: Bytes32 = curry_tree_hash(
        action_layer_mod_hash,
        [
            finalizer_full_hash,                     // already tree-hashed
            tree_hash_atom(registration_merkle_root),
            tree_hash(initial_state),
        ],
    );

    // CAT outer: curry(cat_mod, [cat_mod_hash, cat_tail_hash, action_layer_inner_hash])
    // `action_layer_inner_hash` is already a tree hash → pass directly.
    curry_tree_hash(
        cat_mod_hash,
        [
            tree_hash_atom(cat_mod_hash),
            tree_hash_atom(cat_tail_hash),
            action_layer_inner_hash,
        ],
    )
}

fn main(
    // ── Curried (action-specific config) ────────────────────────────
    TREE_DEPTH: Int,
    EMPTY_LEAF_HASH: Bytes32,
    CAT_MOD_HASH: Bytes32,
    CAT_TAIL_HASH: Bytes32,
    ACTION_LAYER_MOD_HASH: Bytes32,
    REGISTRATION_FINALIZER_MOD_HASH: Bytes32,
    REGISTRATION_MERKLE_ROOT: Bytes32,
    COLLATERAL_AMOUNT: Int,
    ELECTION_LAUNCHER_ID: Bytes32,
    EMPTY_BALLOT_ROOT: Bytes32,
    Truth: ElectionStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    new_voter_pubkey: PublicKey,
    // SEC-F1: the voter's Jubjub pubkey coordinates (32-byte BE). The SMT
    // leaf commits these (not the BLS key); the finalize circuit verifies a
    // Jubjub Schnorr signature by this key. BLS stays the auth/reg-coin key.
    jub_x: Bytes32,
    jub_y: Bytes32,
    register_leaf_index: Int,
    register_siblings: HashCons,
    locked_cat_mojos: Int,
    ...cat_parent_coin_id: Bytes32,
) -> (ElectionStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // Slot integrity: index MUST be the canonical slot for this Jubjub key.
    let computed_slot: Int = slot_from_jubjub(jub_x, jub_y);
    assert register_leaf_index == computed_slot;

    // Verify the slot is currently empty against the current (Poseidon) root.
    let pre_root: Int = compute_root(
        EMPTY_LEAF_HASH as Int, register_leaf_index, register_siblings, TREE_DEPTH,
    );
    assert pre_root == (State.registration_merkle_root as Int);

    // Weighted-voting floor: voters MUST lock at least the curried
    // COLLATERAL_AMOUNT minimum. Locking more than the minimum gives
    // proportionally more vote weight (bound into the leaf below).
    assert locked_cat_mojos >= COLLATERAL_AMOUNT;

    // SECURITY (SEC-INT-ENCODING-ALIASING): `locked_cat_mojos` is a free
    // solution Int. It is hashed below via `int_to_8_bytes_be`, which is
    // only the low 8 bytes (i.e. `n mod 2^64`) — NOT injective. Without
    // an upper bound an attacker could supply `X + 2^64`: the signed `>=`
    // floor still passes (it sees the large positive value), the SMT leaf
    // `sha256(pubkey || enc(X + 2^64))` and the `create_reg` announcement
    // are byte-identical to the honest `X` leaf/announcement, yet
    // `registration_vote_weight += X + 2^64` credits a wildly inflated
    // weight. Reject anything outside [COLLATERAL_AMOUNT, 2^64) so the
    // encoded weight is unambiguous.
    let max_u64: Int = 0x010000000000000000 as Int;
    assert locked_cat_mojos < max_u64;

    // Compute the new root with the weighted SMT leaf inserted at the
    // slot. Per the weighted-voting revision: occupied leaf =
    // sha256(pubkey || locked_cat_mojos_be8). Per-voter weight is
    // bound into the leaf so the circuit can consume each signer's
    // real contribution to `signed_weight` from the same merkle proof
    // the on-chain action verifies.
    let pk_b: Bytes = new_voter_pubkey as Bytes;
    // SEC-F1: weighted Poseidon leaf over the Jubjub pubkey + weight,
    // matching merkle.rs::PoseidonSmt::leaf_hash and the in-circuit leaf.
    let active_leaf: Int = hash_leaf(jub_x as Int, jub_y as Int, locked_cat_mojos);
    let new_root_int: Int = compute_root(
        active_leaf, register_leaf_index, register_siblings, TREE_DEPTH,
    );
    // `int_to_32_bytes_be` always returns 32 bytes; narrow Bytes -> Bytes32.
    let new_root_b: Bytes = int_to_32_bytes_be(new_root_int);
    assert new_root_b is Bytes32;
    let new_root: Bytes32 = new_root_b;

    // Compute the expected CAT-wrapped Registration Coin puzzle hash.
    let reg_full_hash: Bytes32 = fresh_registration_coin_puzzle_hash(
        CAT_MOD_HASH,
        CAT_TAIL_HASH,
        ACTION_LAYER_MOD_HASH,
        REGISTRATION_FINALIZER_MOD_HASH,
        REGISTRATION_MERKLE_ROOT,
        new_voter_pubkey,
        ELECTION_LAUNCHER_ID,
        EMPTY_BALLOT_ROOT,
        locked_cat_mojos,
    );

    // The CAT parent must emit this exact CreateCoinAnnouncement,
    // confirming it has created the Registration Coin with the expected
    // puzzle hash and the voter's chosen locked amount. Binding
    // `locked_cat_mojos` (not the curried minimum) to the announcement
    // ensures the on-chain CAT lockup, the SMT leaf, and the
    // registration_vote_weight increment all agree.
    let bbl_b: Bytes = ELECTION_LAUNCHER_ID as Bytes;
    let create_reg_msg: Bytes32 = sha256(
        "create_reg"
        + bbl_b
        + pk_b
        + (reg_full_hash as Bytes)
        + int_to_8_bytes_be(locked_cat_mojos)
    );
    let assert_cat_creation = AssertCoinAnnouncement {
        id: sha256((cat_parent_coin_id as Bytes) + (create_reg_msg as Bytes)),
    };

    // Voter's signature over a registration message bound to this election.
    let registration_message: Bytes32 = sha256("register" + pk_b + bbl_b);
    let agg_sig_register = AggSigMe {
        public_key: new_voter_pubkey,
        message: registration_message,
    };

    // Indexer / aggregator announcement. Includes `locked_cat_mojos` (the
    // per-leaf weight) and the Jubjub coordinates so off-chain walkers can
    // rebuild the Poseidon SPT (leaf = hash_leaf(jub_x, jub_y, weight)) from
    // chain alone.
    let announce_register = CreateCoinAnnouncement {
        message: sha256(
            "registered"
            + (new_root as Bytes)
            + int_to_8_bytes_be(State.registration_count + 1)
            + pk_b
            + int_to_8_bytes_be(locked_cat_mojos)
            + (jub_x as Bytes)
            + (jub_y as Bytes)
        ),
    };

    let new_state = ElectionState {
        registration_merkle_root: new_root,
        registration_count: State.registration_count + 1,
        registration_vote_weight: State.registration_vote_weight + locked_cat_mojos,
        election_start_height: State.election_start_height,
        ceremony_launcher_id: State.ceremony_launcher_id,
        max_voters: State.max_voters,
        vk_hash: State.vk_hash,
        vote_mode_lock: State.vote_mode_lock,
    };

    (
        ElectionStateTruth {
            Ephemeral_State: Truth.Ephemeral_State,
            State: new_state,
        },
        [
            assert_cat_creation,
            agg_sig_register,
            announce_register,
        ],
    )
}
