// election/shared.rue
// State and types shared by all Election Singleton actions.
//
// The Election Singleton uses the CHIP-0050 action layer with three
// actions: register, finalize, announce_finalization. All three actions
// take an ElectionStateTruth and return a new ElectionStateTruth plus
// conditions.
//
// State semantics:
//   registration_merkle_root  — SPT root of registered voter pubkeys
//   registration_count        — total registered voters
//   accumulated_fees          — XCH (mojos) collected from registration fees
//                               (paid out to the finalizer when finalize runs)
//   finalized                 — false until the finalize action runs once
//   vote_outcome              — zero until finalized; the committed
//                               outcome bytes after finalization

export struct ElectionState {
    registration_merkle_root: Bytes32,
    registration_count: Int,
    accumulated_fees: Int,
    finalized: Bool,
    ...vote_outcome: Bytes32,
}

export struct ElectionStateTruth {
    Ephemeral_State: Any,
    ...State: ElectionState,
}

/// Encode an integer as exactly 8 big-endian bytes.
/// Re-used by every action that hashes a count or epoch value.
export inline fn int_to_8_bytes_be(n: Int) -> Bytes {
    let sentinel: Int = 0x010000000000000000 as Int;
    let padded_bytes: Bytes = (n + sentinel) as Bytes;
    substr(padded_bytes, 1, 9)
}

/// Compute the finalization announcement message.
///
/// Asserted by Registration Coins (release action) when releasing
/// collateral. Centralised here so the finalize and
/// announce_finalization actions emit byte-identical messages.
export inline fn finalization_announcement_msg(
    vote_outcome: Bytes32,
    count: Int,
    merkle_root: Bytes32,
) -> Bytes32 {
    sha256(
        "finalized"
        + (vote_outcome as Bytes)
        + int_to_8_bytes_be(count)
        + (merkle_root as Bytes)
    )
}

/// Compute the oracle announcement message for a FINALIZED election.
///
/// Emitted by the `oracle` action when `State.finalized == true`.
/// Distinct prefix from `finalization_announcement_msg` so external
/// puzzles can opt into "oracle" semantics without colliding with
/// the registration-coin release flow.
///
/// External callers pair the oracle spend with their own spend in
/// the same bundle and emit `AssertCoinAnnouncement` over
/// `sha256(oracle_singleton_coin_id || this_message)` to read the
/// finalized outcome on-chain.
export inline fn oracle_finalized_announcement_msg(
    vote_outcome: Bytes32,
    count: Int,
    merkle_root: Bytes32,
) -> Bytes32 {
    sha256(
        "oracle_finalized"
        + (vote_outcome as Bytes)
        + int_to_8_bytes_be(count)
        + (merkle_root as Bytes)
    )
}

/// Compute the oracle announcement message for an UNFINALIZED
/// election.
///
/// Emitted by the `oracle` action when `State.finalized == false`.
/// Carries the current registration set (count + root) so external
/// puzzles can reason about the in-progress election (e.g., gate a
/// downstream action on a minimum registered count) without ever
/// being able to mistake it for a finalized outcome — the prefix
/// bytes diverge.
export inline fn oracle_unfinalized_announcement_msg(
    count: Int,
    merkle_root: Bytes32,
) -> Bytes32 {
    sha256(
        "oracle_unfinalized"
        + int_to_8_bytes_be(count)
        + (merkle_root as Bytes)
    )
}
