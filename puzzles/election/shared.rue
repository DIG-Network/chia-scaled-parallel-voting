// election/shared.rue
// State and types shared by all Election Singleton actions.

import super::common_types::*;

//
// The Election Singleton uses the CHIP-0050 action layer with actions
// that operate on an ElectionStateTruth and return a new
// ElectionStateTruth plus conditions.
//
// State semantics:
//   registration_merkle_root  — SPT root of registered voter pubkeys
//   registration_count        — total registered voters
//   registration_vote_weight  — total vote weight contributed by
//                               registered voters (sum of CAT collateral
//                               amounts; used by ballots to weight votes)
//   election_start_height     — block height at which this election was
//                               launched. Curried-equivalent constants
//                               (epoch lengths, etc.) are computed
//                               relative to this anchor.
//   ceremony_launcher_id      — launcher_id of the trusted-setup ceremony
//                               singleton this election is bound to.
//                               Set at genesis, propagated unchanged by
//                               every action.
//   max_voters                — registration capacity (= 1 << TREE_DEPTH
//                               of the curried SPT). Matches the chosen
//                               ceremony's max_voters; sourced via the
//                               co-spent voucher's canonical announcement.
//   vk_hash                   — sha256 of the ceremony's derived Groth16
//                               verifying key. Committed in state so any
//                               on-chain consumer can verify the election
//                               uses the exact VK the ceremony produced.
//
// In the multi-ballot architecture, the election singleton no longer
// tracks finalization or a single vote_outcome — those move to
// per-ballot Ballot Coins. Fees are no longer accumulated on the
// singleton (registration fees are routed elsewhere or omitted in this
// rev). A voter who deregisters is announced by the
// `deregister_announcement_msg` so downstream parties can react.

export struct ElectionState {
    registration_merkle_root: Bytes32,
    registration_count: Int,
    registration_vote_weight: Int,
    election_start_height: Int,
    ceremony_launcher_id: Bytes32,
    max_voters: Int,
    vk_hash: Bytes32,
    // M2: per-election ballot-mode lock. Sentinel 0xFF…FF = no lock
    // (each ballot picks its own vote_options_root). Any other value
    // = exact vote_options_root every ballot must commit to.
    ...vote_mode_lock: Bytes32,
}

export struct ElectionStateTruth {
    Ephemeral_State: Any,
    ...State: ElectionState,
}

// `int_to_8_bytes_be` is provided by `common_types.rue` (imported above).

/// Compute the deregistration announcement message.
///
/// Emitted by the Election Singleton's deregister action and asserted
/// by external observers (or by a Registration Coin's release path) so
/// the act of removing a voter from the registered set is observable
/// on-chain in a single canonical form.
export inline fn deregister_announcement_msg(
    voter_pubkey: PublicKey,
) -> Bytes32 {
    sha256(
        "deregister"
        + (voter_pubkey as Bytes)
    )
}
