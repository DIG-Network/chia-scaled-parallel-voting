// ballot_coin/finalize.rue
// Finalize action for the Ballot Coin.
//
// One-shot per ballot. Verifies a SINGLE Groth16 proof (VotingCircuitV2,
// the Option-B finalize circuit) attesting — ENTIRELY in-circuit and at
// O(1) on-chain cost — that registered voters whose combined weight meets
// the curried quorum threshold SIGNED the ballot's vote outcome. It then
// transitions the Ballot Coin's state to finalized=true with the committed
// outcome. Does NOT spend the Election Singleton — the singleton's lane is
// reserved for orchestration (register / createBallot / deregister); this
// is the whole point of moving finalize onto the Ballot Coin under CHIP
// rev 2026-05-02.
//
// SEC-F1 (finalize forgery, closed): the previous design verified a BLS
// AGGREGATE signature on-chain against a caller-supplied `agg_signers` G1
// point. Because nothing bound `agg_signers` to the registered set, a
// forger could pass a self-chosen keypair + matching aggregate and forge
// any outcome (see exploit_finalize_forgery_e2e). The redesign moves ALL
// binding in-circuit:
//   * MEMBERSHIP: each signer's `Poseidon(pubkey.x, pubkey.y, weight)` leaf
//     is proven to be in the registration tree whose root is a public input.
//   * SIGNATURE: each signer's Jubjub Schnorr signature over `vote_message`
//     is verified natively in-circuit (the embedded curve's base field IS
//     the constraint field, so this is cheap — unlike in-circuit BLS12-381).
//   * WEIGHT: the verified weights are summed and the quorum inequality
//     `signed*den >= num*total` is enforced with a range-checked slack.
// `finalize` therefore drops `agg_signers` / `bls_verify` / `g2_map`
// entirely and verifies only the Groth16 pairing — a key whose holder did
// not actually register AND sign THIS outcome can contribute nothing.
//
// Time lock: emits ASSERT_HEIGHT_ABSOLUTE(VOTE_CLOSE_HEIGHT) so the ballot
// must have closed before finalize can run.
//
// FIVE public inputs (ordering MUST match `VotingCircuitV2::public_inputs()`
// and the proven `puzzles/finalize_v2_probe.rue` layout exactly):
//   s1  ←  registration_root          (the Poseidon SPT root snapshot, raw Fr)
//   s2  ←  vote_message               (sha256(outcome||ballot||election) mod r)
//   s3  ←  Fr(registration_vote_weight_snapshot)
//   s4  ←  Fr(vote_threshold_num)
//   s5  ←  Fr(vote_threshold_den)
//
// State transitions:
//   finalized    → true
//   vote_outcome → vote_outcome_data
//   agg_signers  → sha256(vote_message)  (proof-binding commitment; there is
//                  no signer-set aggregate to publish anymore — the quorum
//                  is proven in-circuit. The field is retained so the
//                  BallotState shape / downstream announcement is unchanged.)

import super::common_types::*;
import shared::*;

struct VK {
    alpha: PublicKey,
    beta: Signature,
    gamma: Signature,
    delta: Signature,
}

struct IC {
    ic0: PublicKey,
    ic1: PublicKey,    // multiplied by scalar(registration_root)
    ic2: PublicKey,    // multiplied by scalar(vote_message)
    ic3: PublicKey,    // multiplied by scalar(registration_vote_weight)
    ic4: PublicKey,    // multiplied by scalar(vote_threshold_num)
    ic5: PublicKey,    // multiplied by scalar(vote_threshold_den)
}

struct Proof {
    a: PublicKey,
    b: Signature,
    c: PublicKey,
}

struct Scalars {
    s1: PublicKey,    // registration_root (raw Fr, 32-byte BE)
    s2: PublicKey,    // vote_message mod r
    s3: PublicKey,    // Fr(registration_vote_weight) raw 32-byte BE
    s4: PublicKey,    // Fr(num) raw 32-byte BE
    s5: PublicKey,    // Fr(den) raw 32-byte BE
}

fn main(
    // ── Curried (action-specific config) ────────────────────────────
    VK: VK,
    IC: IC,
    BALLOT_LAUNCHER_ID: Bytes32,
    ELECTION_LAUNCHER_ID: Bytes32,
    VOTE_CLOSE_HEIGHT: Int,
    VOTE_THRESHOLD_NUM: Int,
    VOTE_THRESHOLD_DEN: Int,
    REGISTRATION_MERKLE_ROOT_SNAPSHOT: Bytes32,
    REGISTRATION_VOTE_WEIGHT_SNAPSHOT: Int,
    Truth: BallotStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    proof: Proof,
    vote_outcome_data: Bytes32,
    ...scalars: Scalars,
) -> (BallotStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // One-shot per ballot.
    assert State.finalized == false;

    // Time lock — ballot must have closed.
    let assert_closed = AssertHeightAbsolute {
        height: VOTE_CLOSE_HEIGHT,
    };

    // Vote message binds outcome to ballot identity AND election identity.
    // Order MUST match circuit_v2's `vote_message` input and the
    // aggregator's off-chain derivation (Fr::from_be_bytes_mod_order of the
    // same preimage). A signature over this message can't be replayed onto
    // a different ballot or election.
    let outcome_b: Bytes = vote_outcome_data as Bytes;
    let ballot_b: Bytes = BALLOT_LAUNCHER_ID as Bytes;
    let election_b: Bytes = ELECTION_LAUNCHER_ID as Bytes;

    // BLS12-381 subgroup order r (the Groth16 scalar field). The public
    // inputs are field elements mod r; we bind each supplied scalar to its
    // canonical derivation so a forger cannot pass a proof for a DIFFERENT
    // public-input vector than the one this ballot's curried config + the
    // committed outcome imply.
    let r: Bytes = 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001;
    let zero_pad: Bytes = 0x00;
    let r_int: Int = r as Int;

    // s1 = registration_root. The snapshot is the 32-byte BE of the Poseidon
    // Fr root, which is already a canonical field element (< r), so the
    // public-input scalar equals the snapshot by integer value.
    assert ((scalars.s1 as Bytes) as Int) == (REGISTRATION_MERKLE_ROOT_SNAPSHOT as Int);

    // s2 = vote_message reduced mod r. `0x00 ||` keeps the 256-bit sha256
    // digest a positive Int before the modular reduction.
    let vote_message_int: Int =
        (zero_pad + sha256(outcome_b + ballot_b + election_b)) as Int % r_int;
    assert ((scalars.s2 as Bytes) as Int) == vote_message_int;

    // s3 = Fr(registration_vote_weight). For a u64 < r this is just the
    // integer value; compare numerically so the SDK's 32-byte zero-padded
    // encoding (`fr_to_bytes32_be`) and the canonical int agree.
    assert ((scalars.s3 as Bytes) as Int) == REGISTRATION_VOTE_WEIGHT_SNAPSHOT;

    // s4 / s5 = Fr(num) / Fr(den).
    assert ((scalars.s4 as Bytes) as Int) == VOTE_THRESHOLD_NUM;
    assert ((scalars.s5 as Bytes) as Int) == VOTE_THRESHOLD_DEN;

    // Groth16 prepared input commitment: IC0 + Σ ICi·si.
    let vk_input: PublicKey = IC.ic0
        + IC.ic1 * scalars.s1
        + IC.ic2 * scalars.s2
        + IC.ic3 * scalars.s3
        + IC.ic4 * scalars.s4
        + IC.ic5 * scalars.s5;

    // Groth16 pairing identity:
    //   e(A,B) · e(-alpha,beta) · e(-vk_input,gamma) · e(-C,delta) == 1
    // RAISES (spend rejected) on an invalid proof. This single check is the
    // whole on-chain verification — membership / signatures / weight quorum
    // are all bound inside the proof (see VotingCircuitV2).
    bls_pairing_identity(
        proof.a,    proof.b,
        -VK.alpha,  VK.beta,
        -vk_input,  VK.gamma,
        -proof.c,   VK.delta,
    );

    // Proof-binding commitment. There is no signer-set aggregate to publish
    // (the quorum is proven in-circuit), so we commit the canonical
    // vote_message digest. Downstream consumers get a stable 32-byte
    // identifier; the BallotState shape is unchanged.
    let vote_message_b: Bytes = sha256(outcome_b + ballot_b + election_b);
    let agg_signers_commitment: Bytes32 = sha256(vote_message_b);

    // Finalization announcement — asserted by downstream outcome-gated
    // contracts and re-emittable via announce_finalization.
    let announce_finalize = CreateCoinAnnouncement {
        message: ballot_finalization_msg(
            BALLOT_LAUNCHER_ID,
            vote_outcome_data,
            agg_signers_commitment,
        ),
    };

    let new_state = BallotState {
        finalized: true,
        vote_outcome: vote_outcome_data,
        agg_signers: agg_signers_commitment,
    };

    (
        BallotStateTruth {
            Ephemeral_State: Truth.Ephemeral_State,
            State: new_state,
        },
        [
            assert_closed,
            announce_finalize,
        ],
    )
}
