// voting_coin/update_vote.rue
// Update-vote action for the Voting Coin.
//
// Lets the voter change `vote_data` until the ballot closes. Recreates
// the Voting Coin with the new payload, re-signs `vote_message` for
// the off-chain aggregator, and (defense-in-depth) co-spends the
// Ballot Coin's `oracle` action to re-prove the ballot is still open.
// The Election Singleton is NOT spent — the whole point of CHIP rev
// 2026-05-02 is that vote edits stay on the parallel lane.
//
// Two on-chain checks gate the timing:
//   1. AssertBeforeHeightAbsolute(vote_close_height) — local check
//      against the close height supplied via solution. Cheap and
//      fails closed.
//   2. AssertCoinAnnouncement on the Ballot Coin oracle's
//      "ballot_oracle_open" announcement, which proves the supplied
//      `vote_close_height` is the Ballot Coin's actual curried close
//      height (defends against a malicious mint that lied about
//      close height — see CHIP.md "Why oracle is required"). The
//      State.voter_pubkey signature over `vote_message =
//      sha256(new_vote_data || ballot_launcher_id || election_launcher_id)`
//      cryptographically pins the same triple, so a wrong
//      ballot_launcher_id / election_launcher_id / vote_close_height
//      in the solution either fails the AggSig (different message) or
//      fails the AssertCoinAnnouncement (no Ballot Coin in this
//      bundle emits the wrong-height oracle announcement).
//
// CHIP rev 2026-05-02 (CURRY-ARG-FREE): unlike earlier drafts, this
// action carries no curried args. Per-ballot configuration
// (BALLOT_LAUNCHER_ID, ELECTION_LAUNCHER_ID, VOTE_CLOSE_HEIGHT) flows
// in via solution. WHY: the Voting Coin's action layer's
// `MERKLE_ROOT` is curried into mint_voting_coin as a deployment-wide
// constant (see CHIP.md "Action root composition"). For that to be
// possible, every action of the Voting Coin must have a
// deployment-wide tree hash — which means none of them can carry
// per-ballot curry args. Putting the per-ballot triple in the
// solution + AggSigMe-binding the same triple into `vote_message`
// preserves the security of the on-chain check while keeping the
// action puzzle deployment-wide.
//
// State transition:
//   vote_data → new_vote_data (other curried/state fields unchanged)

import super::common_types::*;
import shared::*;

fn main(
    // No curried args — see file header for rationale.
    Truth: VotingCoinStateTruth,
    // ── Solution ────────────────────────────────────────────────────
    ballot_launcher_id: Bytes32,
    election_launcher_id: Bytes32,
    vote_close_height: Int,
    new_vote_data: Bytes32,
    new_signature: Signature,
    ...ballot_coin_id: Bytes32,
) -> (VotingCoinStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // 1. Local height gate — ballot must still be open.
    let assert_before_close = AssertBeforeHeightAbsolute {
        height: vote_close_height,
    };

    // 2. Ballot Coin oracle co-spend assertion. Pins the Ballot Coin's
    //    actual curried close height to the value we passed in the
    //    solution — defends against a malicious mint having lied at
    //    mint_voting_coin time.
    let ballot_b: Bytes = ballot_launcher_id as Bytes;
    let oracle_message: Bytes32 = sha256(
        "ballot_oracle_open"
        + ballot_b
        + int_to_8_bytes_be(vote_close_height)
    );
    let oracle_announcement_id: Bytes32 = sha256(
        (ballot_coin_id as Bytes)
        + (oracle_message as Bytes)
    );
    let assert_ballot_open = AssertCoinAnnouncement {
        id: oracle_announcement_id,
    };

    // 3. Voter signs the new vote_message. Canonical preimage from
    //    CHIP rev 2026-05-02:
    //      vote_message = sha256(vote_outcome || ballot_launcher_id || election_launcher_id)
    let vm: Bytes32 = vote_message(
        new_vote_data,
        ballot_launcher_id,
        election_launcher_id,
    );
    let agg_sig_update = AggSigMe {
        public_key: State.voter_pubkey,
        message: vm,
    };

    // 4. Aggregator-facing announcement carrying the fresh signature.
    let announce_update = CreateCoinAnnouncement {
        message: sha256(
            "vote_updated"
            + ballot_b
            + (State.voter_pubkey as Bytes)
            + (new_vote_data as Bytes)
            + (new_signature as Bytes)
        ),
    };

    // 5. Recreate Voting Coin with new vote_data; everything else
    //    stays bound to the same registration / ballot / voter.
    let new_state = VotingCoinState {
        voter_pubkey: State.voter_pubkey,
        ballot_launcher_id: State.ballot_launcher_id,
        vote_data: new_vote_data,
        registration_coin_id: State.registration_coin_id,
    };

    (
        VotingCoinStateTruth {
            Ephemeral_State: nil,
            State: new_state,
        },
        [
            assert_before_close,
            assert_ballot_open,
            agg_sig_update,
            announce_update,
        ],
    )
}
