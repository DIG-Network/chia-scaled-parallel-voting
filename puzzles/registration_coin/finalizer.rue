// registration_coin/finalizer.rue
// Custom finalizer for the Registration Coin (CAT inner).
//
// Differs from the standard CHIP-0050 finalizer in two ways:
//
//   1. The output coin's `amount` is taken from the finalizer's
//      solution (`my_amount`) rather than being hard-coded to 1.
//
//      The "odd-amount = 1" pattern from the standard finalizer is an
//      XCH-singleton concern (the singleton outer puzzle requires its
//      coin's amount to be odd). The Registration Coin is wrapped by
//      the standard CAT outer puzzle, which has NO odd-amount
//      constraint on the CAT amount it carries.
//
//      We don't need to curry / hard-code the amount because the CAT
//      outer enforces amount preservation (sum of CAT output amounts
//      must equal sum of CAT input amounts). Since this finalizer
//      always emits exactly one CreateCoin for the recreated parent,
//      the only `my_amount` that will pass the CAT outer's check is
//      the actual input amount — any lie causes the spend to fail.
//
//      The initial CAT amount (COLLATERAL_AMOUNT) is bound at
//      registration time by the Election Singleton's `register` action,
//      which asserts a CreateCoinAnnouncement from the parent CAT spend
//      that commits to the expected amount.
//
//   2. Two branches:
//        - If `release_destination` is set → emit a CreateCoin sending
//          the CAT collateral to `release_destination`. The
//          registration coin lineage ends here. Memos = [HINT].
//        - Else → recreate the action-layer-wrapped Registration Coin
//          at `my_amount` with the new state. Memos = [HINT].
//
// Per CHIP rev 2026-05-02 the Registration Coin no longer carries
// `vote_data` / `vote_signature` directly — those live on the
// Voting Coin minted by `mint_voting_coin`. Aggregators collect
// signatures via the announcement that `mint_voting_coin` (and
// `voting_coin/update_vote`) emit, NOT via Registration Coin memos.
// Hence: no EphemeralVote handling here.
//
// Hint: stays stable across the registration-coin lineage (mints,
// re-mints across ballots) so off-chain indexers can keep tracking
// the voter's collateral coin.

import super::action::StateTruth;
import super::finalizer::*;
import shared::*;

fn main(
    ACTION_LAYER_MOD_HASH: Bytes32,
    HINT: Bytes32,
    // 2nd curry
    FINALIZER_SELF_HASH: Bytes32,
    Truth: FinalizerTruths,
    last_action_output: (StateTruth, List<List<Condition>>),
    // Provided by the spender. Constrained on-chain by the CAT outer's
    // amount-preservation rule — must equal the actual input CAT amount.
    ...my_amount: Int,
) -> List<Condition> {
    let new_state = unchecked_cast::<RegistrationState>(last_action_output.first.actual_state);

    let output_coin = if !(new_state.release_destination is nil) {
        // Release branch: send the CAT collateral to the destination.
        // CAT outer wraps this CreateCoin so the destination receives a
        // CAT coin (not XCH) at the puzzle hash they specified.
        CreateCoin {
            puzzle_hash: new_state.release_destination,
            amount: my_amount,
            memos: Memos {
                value: [HINT],
            }
        }
    } else {
        // Recreate branch.
        let recreated_puzzle_hash: Bytes32 = curry_tree_hash(
            ACTION_LAYER_MOD_HASH,
            [
                curry_tree_hash(
                    FINALIZER_SELF_HASH,
                    [
                        tree_hash_atom(FINALIZER_SELF_HASH),
                    ]
                ),
                tree_hash_atom(Truth.Merkle_Root),
                tree_hash(new_state),
            ]
        );

        CreateCoin {
            puzzle_hash: recreated_puzzle_hash,
            amount: my_amount,
            memos: Memos {
                value: [HINT],
            }
        }
    };

    [
        output_coin,
        ...flatten_list(last_action_output.rest)
    ]
}
