// registration_coin/release.rue
// Release-collateral action for the Registration Coin.
//
// Per CHIP rev 2026-05-02, release is gated by the Election
// Singleton's `deregister` action — NOT by ballot finalization. The
// voter pairs this spend with a singleton `deregister` spend in the
// same bundle so this action can verify the deregister authorization.
//
// Reads voter_pubkey and election_launcher_id from state (rather than
// from a curry), so this action's puzzle hash is a deployment-wide
// constant that lives in the Registration Coin's MERKLE_ROOT.
//
// State transition:
//   release_destination → collateral_destination (provided in solution)
//
// The registration_coin finalizer reads the new state and, because
// release_destination is now non-nil, sends the CAT collateral to that
// destination instead of recreating the registration coin. The
// registration coin lineage ends here.
//
// Voters can release whether or not they have minted Voting Coins for
// any ballot. Existing Voting Coins remain on chain after the parent
// Registration Coin releases — they were already cast, signed, and
// will continue to be aggregable for ballots opened during the
// registration's active window.
//
// SEC-F4 — binding to the GENUINE Election Singleton (CRITICAL):
//   The previous design used `AssertCoinAnnouncement { id:
//   sha256(singleton_coin_id || deregister_msg) }` with
//   `singleton_coin_id` supplied in the SOLUTION. That is forgeable:
//   `ASSERT_COIN_ANNOUNCEMENT` is satisfied by ANY co-spent coin that
//   emits the message, and the attacker chooses `singleton_coin_id` to
//   point at their own dummy coin — so collateral could be released
//   WITHOUT the real singleton's `deregister` ever running.
//
//   This action now uses CHIP-0025 `RECEIVE_MESSAGE` committing the
//   SENDER's PUZZLE HASH. We RE-DERIVE the genuine Election Singleton's
//   puzzle hash from `election_launcher_id` (read from UNFORGEABLE
//   state, never a solution atom) as
//       curry(SINGLETON_TOP_LAYER, SingletonStruct(launcher_id), inner)
//   and require the paired `SEND_MESSAGE` to come from a coin whose
//   puzzle equals it. Only the genuine singleton lineage can land and
//   SPEND a coin at that puzzle hash (the launcher_id coin is unique and
//   already spent; `SINGLETON_TOP_LAYER` rejects any lineage proof that
//   does not descend from it), so a forged announcer cannot satisfy this.
//
//   `singleton_inner_puzzle_hash` is solution-supplied, but that is safe:
//   it only selects WHICH inner puzzle the committed singleton puzzle
//   hash is built around. To actually pair the message, a real coin at
//   curry(SINGLETON_TOP_LAYER, struct(launcher_id), that_inner) must be
//   co-spent — and no such coin is spendable outside the genuine
//   singleton's launcher lineage. RESIDUAL (documented in
//   SECURITY_FINDINGS.md): a *clone* singleton sharing the same
//   launcher_id is impossible (a launcher coin is spent exactly once),
//   so there is no clone-singleton bypass.

import super::common_types::*;
import shared::*;

// Canonical Chia singleton constants (chia-puzzles): the curried
// singleton_top_layer_v1_1 mod hash and the singleton launcher puzzle
// hash. Used to re-derive the Election Singleton's puzzle hash from its
// launcher_id, matching `SingletonArgs::curry_tree_hash` in the SDK.
inline const SINGLETON_TOP_LAYER_MOD_HASH: Bytes32 =
    0x7faa3253bfddd1e0decb0906b2dc6247bbc4cf608f58345d173adb63e8b47c9f;
inline const SINGLETON_LAUNCHER_PUZZLE_HASH: Bytes32 =
    0xeff07522495060c066f66f32acc2a77e3a3e737aca8baea4d1a64ea4cdc13da9;

fn main(
    Truth: RegistrationStateTruth,
    collateral_destination: Bytes32,
    ...singleton_inner_puzzle_hash: Bytes32,
) -> (RegistrationStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // Cannot release twice.
    assert State.release_destination is nil;

    // SEC-F2: the release branch of the finalizer pays out the coin's real
    // CAT amount. Asserting the coin holds exactly `locked_weight` keeps
    // the released collateral equal to what the voter genuinely staked and
    // consistent with their SMT leaf weight, so a forged-weight
    // registration cannot release more than it actually locked.
    let assert_my_amount = AssertMyAmount {
        amount: State.locked_weight,
    };

    let pk_b: Bytes = State.voter_pubkey as Bytes;
    let el_b: Bytes = State.election_launcher_id as Bytes;
    let dest_b: Bytes = collateral_destination as Bytes;

    // SEC-F4: re-derive the genuine Election Singleton's puzzle hash from
    // the UNFORGEABLE `election_launcher_id` in state plus the singleton's
    // inner puzzle hash. This is exactly `SingletonArgs::curry_tree_hash(
    // election_launcher_id, singleton_inner_puzzle_hash)`.
    let singleton_struct = std::singleton::SingletonStruct {
        mod_hash: SINGLETON_TOP_LAYER_MOD_HASH,
        launcher_id: State.election_launcher_id,
        launcher_puzzle_hash: SINGLETON_LAUNCHER_PUZZLE_HASH,
    };
    let singleton_struct_hash: Bytes32 = tree_hash(singleton_struct);
    let singleton_puzzle_hash: Bytes32 = curry_tree_hash(
        SINGLETON_TOP_LAYER_MOD_HASH,
        [singleton_struct_hash, singleton_inner_puzzle_hash],
    );

    // The deregister authorization message the singleton's `deregister`
    // action emits via SEND_MESSAGE:
    //   sha256("deregister" || voter_pubkey)
    // Inlined here rather than imported from election/shared to keep
    // registration_coin/ self-contained (no cross-coin imports).
    let deregister_message: Bytes32 = sha256(
        "deregister" + pk_b
    );

    // CHIP-0025 RECEIVE_MESSAGE, mode = SENDER_PUZZLE (commit the
    // sender's puzzle hash; no receiver-side commitment). Consensus pairs
    // this only with a SEND_MESSAGE emitted by a coin whose puzzle hash
    // equals `singleton_puzzle_hash` — i.e. the genuine Election
    // Singleton spending its `deregister` action in the same bundle.
    let receive_deregister = ReceiveMessage {
        mode: SENDER_PUZZLE,
        message: deregister_message as Bytes,
        sender: [singleton_puzzle_hash as Bytes],
    };

    // Voter authorises the destination via AggSigMe. Message binds
    // (pubkey, election_id, destination) so a signature for one
    // destination can't be replayed for another.
    let release_message: Bytes32 = sha256(
        "release" + el_b + pk_b + dest_b
    );
    let agg_sig_release = AggSigMe {
        public_key: State.voter_pubkey,
        message: release_message,
    };

    let new_state = RegistrationState {
        voter_pubkey: State.voter_pubkey,
        election_launcher_id: State.election_launcher_id,
        voted_ballots_root: State.voted_ballots_root,
        locked_weight: State.locked_weight,
        release_destination: collateral_destination,
    };

    (
        RegistrationStateTruth {
            Ephemeral_State: nil,
            State: new_state,
        },
        [receive_deregister, agg_sig_release, assert_my_amount],
    )
}
