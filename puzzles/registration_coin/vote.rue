// registration_coin/vote.rue
// Vote action for the Registration Coin.
//
// The voter casts their vote. Reads voter_pubkey and election_launcher_id
// from state (rather than from a curry), so this action's puzzle hash is
// a deployment-wide constant that lives in the Registration Coin's
// MERKLE_ROOT.
//
// State transitions:
//   has_voted          → true
//   vote_data          → vote_data from solution (committed on-chain)
//   release_destination remains nil
//
// Ephemeral state (passed to the finalizer):
//   EphemeralVote { vote_data, vote_signature }
//
// The finalizer reads ephemeral state and writes (vote_data,
// vote_signature) into the memos of the recreated registration coin so
// off-chain aggregators can extract them with a single coin-record
// lookup (no need to parse CLVM solutions).
//
// Vote message format:
//   sha256("vote" || election_launcher_id || voter_pubkey || vote_data)
//
// AggSigUnsafe is used (not AggSigMe) so the voter's signature is a
// clean signature over the standardised vote_message — the same
// signature that the off-chain BLS aggregator collects from the memo
// for inclusion in the Election Singleton's finalize input.
//
// Replay prevention: has_voted=true is asserted at the start of this
// action and is part of the curried state, so the same coin lineage
// cannot vote a second time.

import shared::*;

fn main(
    Truth: RegistrationStateTruth,
    vote_data: Bytes32,
    ...vote_signature: Signature,
) -> (RegistrationStateTruth, List<Condition>) {
    inline let State = Truth.State;

    // One vote per registration.
    assert State.has_voted == false;
    // Cannot vote after release has been initiated.
    assert State.release_destination is nil;

    let pk_b: Bytes = State.voter_pubkey as Bytes;
    let el_b: Bytes = State.election_launcher_id as Bytes;
    let vote_data_b: Bytes = vote_data as Bytes;

    let vote_message: Bytes32 = sha256(
        "vote" + el_b + pk_b + vote_data_b
    );

    // AggSigUnsafe — the spend bundle's aggregate signature must
    // include a valid signature from voter_pubkey over vote_message.
    // The signature passed in solution (vote_signature) is what the
    // finalizer writes into the recreated coin's memos for off-chain
    // aggregation. If the spender lies and puts a different signature
    // in solution, the off-chain verifier will reject the vote (the
    // memo signature won't verify against vote_message).
    let agg_sig_vote = AggSigUnsafe {
        public_key: State.voter_pubkey,
        message: vote_message,
    };

    let new_state = RegistrationState {
        voter_pubkey: State.voter_pubkey,
        election_launcher_id: State.election_launcher_id,
        has_voted: true,
        vote_data: vote_data,
        release_destination: nil,
    };

    (
        RegistrationStateTruth {
            Ephemeral_State: EphemeralVote {
                vote_data: vote_data,
                vote_signature: vote_signature,
            },
            State: new_state,
        },
        [agg_sig_vote],
    )
}
